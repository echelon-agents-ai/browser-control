    "gen-key": "node scripts/gen-extension-key.mjs"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "license": "MIT"
}
