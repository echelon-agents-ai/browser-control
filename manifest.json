{
  "manifest_version": 3,
  "name": "Browser Control",
  "version": "0.1.0",
  "description": "Open-source, agent-first Chrome extension: vision-first browser control over MCP.",
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "scripting",
    "nativeMessaging",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
