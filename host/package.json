{
  "name": "browser-control-host",
  "version": "0.2.0",
  "private": true,
  "description": "Browser Control host: launchd daemon (MCP server, auth, password-manager bridge, tenant router) + stdio native-messaging shim.",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "start:daemon": "node dist/daemon/index.js",
    "start:shim": "node dist/shim/index.js",
    "install-manifest": "tsx daemon/installManifest.ts",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit",
    "install-cft": "bash -c 'v=${BUE_CFT_VERSION:-154.0.8037.57}; npx --yes @puppeteer/browsers install chrome@$v --path \"${BUE_CFT_ROOT:-$HOME/Library/Application Support/BrowserControl/cft}/$v\"'",
    "smoke:cft": "bash scripts/smoke-cft.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^5.0.1"
  },
  "license": "MIT"
}
